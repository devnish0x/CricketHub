# =====================================================================
# Crickethub - Environment Configuration Template
# Copy this file to .env and fill in your actual Oracle credentials.
# NEVER commit the real .env file with production credentials to git!
# =====================================================================

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace_with_a_secure_random_secret_key_for_sessions_12345

# Oracle Database Connection Settings
# For Oracle 21c XE local installation:
# Host is typically localhost or 127.0.0.1
# Port is default 1521
# Service Name is usually XE (for 21c XE container root) or XEPDB1 (for pluggable DB)
ORACLE_USER=crickethub_admin
ORACLE_PASSWORD=your_secure_password_here
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XE

# Optional: Full Oracle DSN string (if preferred over host/port/service)
# e.g., localhost:1521/XE or localhost:1521/XEPDB1
# ORACLE_DSN=localhost:1521/XE
